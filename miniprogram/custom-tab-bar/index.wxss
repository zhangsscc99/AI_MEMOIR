/* custom-tab-bar/index.wxss */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: #e8e8e8;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 4rpx;
}

.tab-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: block;
  flex-shrink: 0;
}

.tab-icon-home {
  transform: translateX(2rpx);
}

.tab-icon-pencil {
  transform: translateX(5rpx);
}

.tab-icon-profile {
  transform: translateX(2rpx);
}

.tab-label {
  width: 100%;
  margin-top: 4rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1;
  color: #999999;
}

.tab-label.active {
  color: #ff6b47;
}

.tab-label-pair {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 4rpx;
}

.tab-label-char {
  width: 20rpx;
  text-align: center;
}
