<!-- custom-tab-bar/index.wxml -->
<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-bar-item"
    bindtap="switchTab"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
  >
    <view class="tab-icon-wrap">
      <image
        class="tab-icon {{item.iconClass}}"
        src="{{selected === index ? item.iconActive : item.icon}}"
        mode="aspectFit"
      />
    </view>
    <view wx:if="{{item.splitLabel}}" class="tab-label tab-label-pair {{selected === index ? 'active' : ''}}">
      <text class="tab-label-char">{{item.splitLabel[0]}}</text>
      <text class="tab-label-char">{{item.splitLabel[1]}}</text>
    </view>
    <text wx:else class="tab-label {{selected === index ? 'active' : ''}}">{{item.text}}</text>
  </view>
</view>
