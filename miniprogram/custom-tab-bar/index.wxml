<!-- custom-tab-bar/index.wxml -->
<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-bar-item"
    bindtap="switchTab"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
  >
    <image
      class="tab-icon"
      src="{{selected === index ? item.iconActive : item.icon}}"
      mode="aspectFit"
    />
    <text class="tab-label {{selected === index ? 'active' : ''}}">{{item.text}}</text>
  </view>
</view>
