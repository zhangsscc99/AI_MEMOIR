/* app.wxss - 全局样式（对齐原版设计） */
page {
  background-color: #f8f8f8;
  color: #333333;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

/* 主色按钮（橙色） */
.btn-primary {
  background: #FF6B47;
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 22rpx 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  text-align: center;
  display: block;
}
.btn-primary::after { border: none; }

/* 白色毛玻璃按钮（原版风格） */
.btn-glass {
  background: rgba(255,255,255,0.85);
  color: #333;
  border-radius: 48rpx;
  padding: 22rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  text-align: center;
  display: block;
}
.btn-glass::after { border: none; }

/* 主色 */
.text-primary { color: #FF6B47; }
.text-secondary { color: #666; }
.text-muted { color: #999; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #999; }

/* 加载 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top-color: #FF6B47;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
