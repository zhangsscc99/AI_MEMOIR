/* pages/memoir/memoir.wxss */

.page {
  background: #FAF8F5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 120rpx;
}

/* 书籍封面 */
.book-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 40rpx 60rpx 0;
}

.book-image {
  width: 480rpx;
  height: 600rpx;
  border-radius: 12rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.18);
}

/* 欢迎文字 */
.welcome-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 40rpx 0;
  text-align: center;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2d2d2d;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.welcome-desc-block {
  margin-bottom: 24rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #555;
  display: block;
  line-height: 1.8;
}

/* 金色回忆录标题 */
.memoir-title-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.quote-mark {
  font-size: 56rpx;
  font-weight: 300;
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 25%, #FDB931 50%, #D4AF37 75%, #B8860B 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  opacity: 0.9;
  line-height: 1;
}

.memoir-title-text {
  font-size: 64rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 25%, #FDB931 50%, #D4AF37 75%, #B8860B 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin: 0 16rpx;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

/* CTA 按钮 */
.cta-btn {
  width: 560rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 !important;
  background-color: #FFFFFF !important;
  color: #333 !important;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.10);
  text-align: center;
  margin: 40rpx auto 0;
  display: block;
}
.cta-btn::after { border: none; }

/* 章节列表 */
.chapter-list {
  width: 100%;
  padding: 32rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.chapter-item {
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 25rpx rgba(0,0,0,0.12);
}

.chapter-bg-img {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
}

.chapter-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.15) 30%, rgba(0,0,0,0.6) 100%);
}

.chapter-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx 24rpx;
}

.chapter-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.chapter-num-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.done-badge {
  width: 40rpx;
  height: 40rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
}

.chapter-title-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  display: block;
  margin-bottom: 6rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.4);
}

.chapter-desc-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  line-height: 1.5;
}
