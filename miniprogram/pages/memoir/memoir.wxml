<!-- pages/memoir/memoir.wxml -->
<view class="page">

  <!-- 书籍封面 -->
  <view class="book-wrap">
    <image class="book-image" src="https://636c-cloud1-9gbxfuqjd1864b3c-1359119781.tcb.qcloud.la/images/memoirbook.png" mode="aspectFit" />
  </view>

  <!-- 欢迎文字 -->
  <view class="welcome-block">
    <text class="welcome-title">欢迎来到岁月镜像！</text>
    <view class="welcome-desc-block">
      <text class="welcome-desc">选择您想要记录的人生章节，</text>
      <text class="welcome-desc">开始您的回忆之旅</text>
    </view>
    <view class="memoir-title-section">
      <text class="quote-mark">"</text>
      <text class="memoir-title-text">回忆录</text>
      <text class="quote-mark">"</text>
    </view>
  </view>

  <!-- CTA 按钮 -->
  <button class="cta-btn" bindtap="goChapters">开启回忆之旅</button>

</view>
