<!-- pages/memoir/memoir.wxml -->
<view class="page">

  <!-- 书籍封面 -->
  <view class="book-wrap">
    <image class="book-image" src="/images/memoirbook.png" mode="aspectFit" />
  </view>

  <!-- 欢迎文字 -->
  <view class="welcome-block">
    <text class="welcome-title">欢迎来到岁月镜像！</text>
    <view class="welcome-desc-block">
      <text class="welcome-desc">选择您想要记录的人生章节，</text>
      <text class="welcome-desc">开始您的回忆之旅</text>
    </view>
    <view class="memoir-title-section">
      <text class="quote-mark">"</text>
      <text class="memoir-title-text">回忆录</text>
      <text class="quote-mark">"</text>
    </view>
  </view>

  <!-- CTA 按钮 -->
  <button class="cta-btn" bindtap="toggleChapters">开启回忆之旅</button>

  <!-- 章节列表（展开后显示） -->
  <view wx:if="{{showChapters}}" class="chapter-list">
    <view
      wx:for="{{chapterList}}"
      wx:key="id"
      class="chapter-item"
      bindtap="goChapter"
      data-id="{{item.id}}"
      data-title="{{item.title}}"
    >
      <image class="chapter-bg-img" src="/images/{{item.image}}" mode="aspectFill" />
      <view class="chapter-overlay"></view>
      <view class="chapter-body">
        <view class="chapter-top">
          <text class="chapter-num-text">{{item.num}}</text>
          <view wx:if="{{item.hasContent}}" class="done-badge">✓</view>
        </view>
        <text class="chapter-title-text">{{item.title}}</text>
        <text class="chapter-desc-text">{{item.desc}}</text>
      </view>
    </view>
  </view>

</view>
