/* pages/diary/diary.wxss */

.page {
  background: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* 页头 */
.page-header {
  padding: 32rpx 28rpx 24rpx;
}

.page-big-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #666;
  display: block;
  line-height: 1.6;
}

/* 列表 */
.diary-list {
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* 列表项 */
.diary-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: visible;
}

/* 缩略图 */
.diary-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.diary-thumb-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.thumb-icon {
  font-size: 44rpx;
}

/* 内容 */
.diary-content {
  flex: 1;
  min-width: 0;
}

.diary-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diary-date {
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* 三点菜单触发器 */
.menu-trigger {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
  padding: 10rpx 12rpx;
  flex-shrink: 0;
}

.dot {
  width: 7rpx;
  height: 7rpx;
  background: #ccc;
  border-radius: 50%;
}

/* 操作菜单弹出 */
.action-menu {
  position: absolute;
  right: 10rpx;
  top: 60rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.15);
  z-index: 100;
  overflow: hidden;
  min-width: 160rpx;
}

.action-item {
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.action-delete {
  color: #FF4757;
}

.action-divider {
  height: 1rpx;
  background: #f0f0f0;
}

/* 悬浮按钮（原版样式：白色毛玻璃） */
.fab {
  position: fixed;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 24rpx);
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255,255,255,0.88);
  border-radius: 50rpx;
  padding: 22rpx 60rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
  border: 1rpx solid rgba(255,255,255,0.6);
  z-index: 50;
}

.fab-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* 加载 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top-color: #FF6B47;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; }
