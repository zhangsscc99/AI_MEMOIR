/* pages/profile/profile.wxss */

.page {
  background: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ===== 登录状态 ===== */

/* 用户卡片 */
.user-card {
  background: #FFFFFF;
  margin: 24rpx 20rpx 16rpx;
  border-radius: 20rpx;
  padding: 40rpx 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.avatar-wrap {
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder.large {
  width: 160rpx;
  height: 160rpx;
}

.avatar-initial {
  font-size: 52rpx;
  color: #bbb;
  font-weight: bold;
}

.large-initial {
  font-size: 72rpx;
}

.user-greeting {
  font-size: 36rpx;
  font-weight: bold;
  color: #2d2d2d;
}

.user-badge {
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
}

.badge-text {
  font-size: 24rpx;
  color: #888;
}

/* 菜单卡片 */
.menu-card {
  background: #FFFFFF;
  margin: 0 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
}

.menu-icon {
  font-size: 40rpx;
  width: 48rpx;
  text-align: center;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

.menu-divider {
  height: 1rpx;
  background: #f5f5f5;
  margin: 0 28rpx;
}

/* 底部链接 */
.footer-links {
  padding: 28rpx;
  text-align: center;
  border-top: 1rpx solid #f5f5f5;
}

.footer-links.top-margin {
  border-top: none;
  padding-top: 0;
}

.footer-link {
  font-size: 24rpx;
  color: #5B9BD5;
}

.footer-sep {
  font-size: 24rpx;
  color: #ccc;
}

/* ===== 未登录状态 ===== */

.welcome-card {
  background: #FFFFFF;
  margin: 40rpx 32rpx;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}

.welcome-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #f0f0f0;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2d2d2d;
  display: block;
}

.welcome-sub {
  font-size: 28rpx;
  color: #999;
  display: block;
}
