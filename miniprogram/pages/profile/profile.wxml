<!-- pages/profile/profile.wxml -->
<view class="page">

  <!-- 登录状态：显示用户信息 + 菜单 -->
  <block wx:if="{{userInfo}}">
    <!-- 用户卡片 -->
    <view class="user-card">
      <view class="avatar-wrap" bindtap="changeAvatar">
        <image wx:if="{{userInfo.avatar}}" class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-initial">{{userInfo.nickname ? userInfo.nickname[0] : '用'}}</text>
        </view>
      </view>
      <text class="user-greeting">Hi~ {{userInfo.nickname || '用户'}}</text>
      <view class="user-badge"><text class="badge-text">普通用户</text></view>
    </view>

    <!-- 菜单 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="goShopping">
        <text class="menu-icon">🛒</text>
        <text class="menu-label">我的购物</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="goOrders">
        <text class="menu-icon">📋</text>
        <text class="menu-label">我的订单</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="goSupport">
        <text class="menu-icon">💬</text>
        <text class="menu-label">客服支持</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="goFeedback">
        <text class="menu-icon">📣</text>
        <text class="menu-label">意见反馈</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="goShare">
        <text class="menu-icon">📤</text>
        <text class="menu-label">分享应用</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="goBusiness">
        <text class="menu-icon">🤝</text>
        <text class="menu-label">商务合作</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bindtap="logout">
        <text class="menu-icon">🚪</text>
        <text class="menu-label">退出登录</text>
        <text class="menu-arrow">›</text>
      </view>

      <view class="footer-links">
        <text class="footer-link">用户服务协议</text>
        <text class="footer-sep"> | </text>
        <text class="footer-link">隐私政策</text>
      </view>
    </view>
  </block>

  <!-- 未登录状态：居中卡片（对齐原版） -->
  <block wx:else>
    <view class="welcome-card">
      <image class="welcome-avatar" src="/images/zaomen.jpeg" mode="aspectFill" />
      <text class="welcome-title">欢迎使用岁月镜像</text>
      <text class="welcome-sub">开始记录您的人生故事</text>
      <view class="footer-links top-margin">
        <text class="footer-link">用户服务协议</text>
        <text class="footer-sep"> | </text>
        <text class="footer-link">隐私政策</text>
      </view>
    </view>
  </block>

</view>
