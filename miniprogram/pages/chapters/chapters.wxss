/* pages/chapters/chapters.wxss */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f2f5;
}

.status-bar { background: #ffffff; flex-shrink: 0; }

/* 导航栏 */
.nav-bar {
  height: 88rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  background: #f5f5f5;
  border: 1rpx solid #e8e8e8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-icon { font-size: 32rpx; color: #333; line-height: 1; }

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  text-align: center;
}

/* 进度统计卡片 */
.stats-card {
  background: #ffffff;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  flex-shrink: 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  line-height: 1;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background: #eeeeee;
}

/* 章节滚动区 */
.chapter-scroll {
  flex: 1;
  overflow: hidden;
}

.chapter-list {
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 章节卡片 */
.chapter-item {
  height: 240rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 25rpx rgba(0,0,0,0.14);
}

.chapter-bg-img {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
}

.chapter-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.12) 30%, rgba(0,0,0,0.65) 100%);
}

.chapter-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx 28rpx;
}

.chapter-num-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.80);
  display: block;
  margin-bottom: 6rpx;
}

.chapter-title-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.4);
}

.chapter-desc-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.80);
  display: block;
  line-height: 1.5;
}

/* 完成徽章 */
.done-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.done-badge-text { font-size: 24rpx; color: #fff; }

/* 底部提示 */
.hint-wrap {
  padding: 32rpx 0 40rpx;
  display: flex;
  justify-content: center;
}
.hint-text {
  font-size: 24rpx;
  color: #999;
}
