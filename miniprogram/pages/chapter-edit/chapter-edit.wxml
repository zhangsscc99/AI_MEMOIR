<!-- pages/chapter-edit/chapter-edit.wxml -->
<view class="page">

  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="nav-back-icon">←</text>
    </view>
    <text class="nav-title">{{chapterTitle}}</text>
    <view class="nav-save-btn {{saving ? 'saving' : ''}}" bindtap="saveChapter">
      <text class="nav-save-text">{{saving ? '保存中' : '保存'}}</text>
    </view>
  </view>

  <!-- 可滚动内容区 -->
  <scroll-view class="content" scroll-y>

    <!-- 引导问题卡片 -->
    <view class="prompts-card" wx:if="{{prompts.length > 0}}">
      <text class="prompts-heading">引导问题</text>
      <view
        wx:for="{{prompts}}"
        wx:key="index"
        class="prompt-item"
      >
        <view class="prompt-num-circle">
          <text class="prompt-num-text">{{index + 1}}</text>
        </view>
        <text class="prompt-text">{{item}}</text>
      </view>
    </view>

    <!-- 记录卡片 -->
    <view class="record-card">
      <text class="date-text">{{dateStr}}</text>
      <view class="record-divider"></view>
      <textarea
        class="content-textarea"
        placeholder="开始记录您的回忆..."
        placeholder-class="textarea-ph"
        value="{{content}}"
        bindinput="onContentInput"
        auto-height
        show-confirm-bar="{{false}}"
        cursor-spacing="160"
      />
    </view>

    <view class="content-spacer"></view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-btn-wrap" bindtap="toggleRecording">
      <view class="bottom-circle {{isRecording ? 'recording' : ''}}">
        <image class="bottom-circle-icon" src="https://636c-cloud1-9gbxfuqjd1864b3c-1359119781.tcb.qcloud.la/images/icons/microphone.svg" mode="aspectFit" />
      </view>
      <text class="bottom-label">{{isRecording ? '结束录制' : '点击录制'}}</text>
    </view>
    <view class="bottom-btn-wrap" bindtap="aiPolish">
      <view class="bottom-circle {{aiPolishing ? 'loading' : ''}}">
        <image class="bottom-circle-icon" src="https://636c-cloud1-9gbxfuqjd1864b3c-1359119781.tcb.qcloud.la/images/icons/chat.svg" mode="aspectFit" />
      </view>
      <text class="bottom-label">AI补全</text>
    </view>
  </view>

</view>
