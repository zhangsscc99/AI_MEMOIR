/* pages/chapter-edit/chapter-edit.wxss */

.container {
  background: #F5F0E8;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 背景图片区 */
.bg-image-area {
  width: 100%;
  height: 320rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #C8A882, #A07050);
}

.bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.bg-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.placeholder-icon {
  font-size: 80rpx;
  opacity: 0.7;
}

.placeholder-text {
  color: rgba(255,255,255,0.8);
  font-size: 26rpx;
}

.bg-image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
}

.chapter-title-text {
  position: absolute;
  bottom: 30rpx;
  left: 40rpx;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}

/* 工具栏 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #F0E8DF;
  position: sticky;
  top: 0;
  z-index: 100;
}

.toolbar-left,
.toolbar-right {
  display: flex;
  gap: 10rpx;
}

.toolbar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  background: #F8F5F0;
  min-width: 80rpx;
}

.toolbar-btn.recording {
  background: #FFF0F0;
}

.toolbar-btn.ai-btn {
  background: #F0F4FF;
}

.toolbar-btn.save-btn {
  background: #F0FFF4;
}

.toolbar-btn.loading {
  opacity: 0.6;
}

.toolbar-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.toolbar-label {
  font-size: 20rpx;
  color: #666;
}

/* 录音列表 */
.recordings-section {
  background: #FFFFFF;
  margin: 20rpx 0;
  padding: 24rpx 30rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A2C17;
}

.recordings-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recording-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F8F5F0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.recording-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.play-btn {
  width: 60rpx;
  height: 60rpx;
  background: #8B4513;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF;
  font-size: 24rpx;
}

.recording-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  font-weight: 600;
}

.recording-meta {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.recording-actions {
  display: flex;
  gap: 16rpx;
}

.recording-transcribe {
  font-size: 24rpx;
  color: #8B4513;
  padding: 8rpx 16rpx;
  background: #FFF3E0;
  border-radius: 20rpx;
}

.recording-delete {
  font-size: 24rpx;
  color: #FF5252;
  padding: 8rpx 16rpx;
  background: #FFF0F0;
  border-radius: 20rpx;
}

/* 编辑区 */
.editor-section {
  background: #FFFFFF;
  margin: 0;
  padding: 24rpx 30rpx;
  min-height: 400rpx;
}

.word-count {
  font-size: 22rpx;
  color: #BBAA99;
  text-align: right;
  margin-bottom: 16rpx;
}

.content-editor {
  width: 100%;
  min-height: 360rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  box-sizing: border-box;
}

.editor-placeholder {
  color: #CCBBAA;
  font-size: 30rpx;
  line-height: 1.8;
}

/* 录音浮层 */
.recording-overlay {
  position: fixed;
  bottom: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(139, 69, 19, 0.9);
  border-radius: 30rpx;
  padding: 30rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  backdrop-filter: blur(10px);
}

.recording-wave {
  display: flex;
  gap: 8rpx;
  align-items: center;
  height: 50rpx;
}

.wave-bar {
  width: 8rpx;
  background: #FFFFFF;
  border-radius: 4rpx;
  animation: wave 0.6s ease-in-out infinite;
}

.wave-bar:nth-child(1) { height: 20rpx; animation-delay: 0s; }
.wave-bar:nth-child(2) { height: 36rpx; animation-delay: 0.1s; }
.wave-bar:nth-child(3) { height: 50rpx; animation-delay: 0.2s; }
.wave-bar:nth-child(4) { height: 36rpx; animation-delay: 0.3s; }
.wave-bar:nth-child(5) { height: 20rpx; animation-delay: 0.4s; }

@keyframes wave {
  0%, 100% { transform: scaleY(0.5); }
  50% { transform: scaleY(1); }
}

.recording-time {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: bold;
  font-variant-numeric: tabular-nums;
}

.recording-tip {
  color: rgba(255,255,255,0.8);
  font-size: 22rpx;
}
