/* pages/chapter-edit/chapter-edit.wxss */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f2f5;
}

.status-bar { background: #ffffff; flex-shrink: 0; }

/* 导航栏 */
.nav-bar {
  height: 88rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  background: #f5f5f5;
  border: 1rpx solid #e8e8e8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-icon { font-size: 32rpx; color: #333; line-height: 1; }

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  text-align: center;
}

.nav-save-btn {
  padding: 14rpx 32rpx;
  background: #f5f5f5;
  border: 1rpx solid #e8e8e8;
  border-radius: 40rpx;
}
.nav-save-btn.saving { opacity: 0.6; }
.nav-save-text { font-size: 28rpx; font-weight: bold; color: #333; }

/* 内容区 */
.content {
  flex: 1;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
}

/* 引导问题卡片 */
.prompts-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.prompts-heading {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.prompt-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.prompt-item:last-child { border-bottom: none; padding-bottom: 0; }

.prompt-num-circle {
  width: 40rpx;
  height: 40rpx;
  background: #333333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.prompt-num-text { font-size: 22rpx; color: #ffffff; font-weight: 600; }

.prompt-text { font-size: 28rpx; color: #555; line-height: 1.6; flex: 1; }

/* 记录卡片 */
.record-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  min-height: 320rpx;
}

.date-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.record-divider {
  height: 1rpx;
  background: #eeeeee;
  margin-bottom: 24rpx;
}

.content-textarea {
  width: 100%;
  min-height: 320rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}
.textarea-ph { color: #bbb; font-size: 30rpx; }

.content-spacer { height: 32rpx; }

/* 底部操作栏 */
.bottom-bar {
  background: #f8f8f8;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 100rpx;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.bottom-btn-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.bottom-circle {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255,255,255,0.95);
  border: 2rpx solid #e0e0e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.10);
}
.bottom-circle.recording {
  background: rgba(255,59,48,0.10);
  border-color: #FF3B30;
}
.bottom-circle.loading {
  background: rgba(0,122,255,0.10);
  border-color: #007AFF;
}

.bottom-circle-icon { width: 44rpx; height: 44rpx; }
.bottom-label { font-size: 24rpx; color: #333; font-weight: 500; }
