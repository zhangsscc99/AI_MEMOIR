/* pages/index/index.wxss */

.page {
  background: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ===== 回忆录卡片 ===== */
.memoir-card {
  background: linear-gradient(135deg, #f8f6f3, #ede8e3);
  margin: 24rpx 24rpx 16rpx;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  overflow: hidden;
}

.memoir-book {
  flex-shrink: 0;
}

/* 书籍封面图片 */
.book-cover-img {
  width: 120rpx;
  height: 160rpx;
  border-radius: 8rpx;
  box-shadow: -4rpx 4rpx 16rpx rgba(0,0,0,0.25);
}

/* 回忆录信息 */
.memoir-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.memoir-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2d2d2d;
  display: block;
  margin-bottom: 8rpx;
}

.memoir-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.memoir-progress {
  margin-bottom: 12rpx;
}

.progress-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #2d2d2d;
  line-height: 1;
}

.progress-label {
  font-size: 24rpx;
  color: #666;
}

.progress-bar {
  height: 8rpx;
  background: rgba(0,0,0,0.1);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B47, #FF8A65);
  border-radius: 8rpx;
  min-width: 4rpx;
}

/* 操作按钮 */
.memoir-btns {
  display: flex;
  gap: 16rpx;
}

.memoir-btn {
  flex: 1;
  background: rgba(255,255,255,0.8);
  color: #333;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.4;
}
.memoir-btn::after { border: none; }

/* ===== 随记横幅 ===== */
.diary-banner {
  margin: 0 24rpx 24rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}

.diary-banner-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
}

.diary-banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(40deg, rgba(0,0,0,0.60) 30%, rgba(0,0,0,0.25));
}

.diary-banner-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 28rpx;
  z-index: 1;
}

.diary-banner-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.diary-banner-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.88);
  display: block;
  line-height: 1.5;
}

/* ===== 章节预览 ===== */
.chapters-section {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 0 12rpx;
  margin: 0 24rpx;
}

.section-header {
  padding: 0 28rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d2d2d;
}

.chapters-scroll {
  width: 100%;
  white-space: nowrap;
}

.chapters-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 28rpx 20rpx;
}

.chapter-card {
  width: 240rpx;
  height: 300rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}

.chapter-bg-img {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
}

.chapter-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.15) 40%, rgba(0,0,0,0.65) 100%);
}

.chapter-card-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 20rpx 22rpx;
}

.chapter-num {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-bottom: 6rpx;
}

.chapter-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  display: block;
  margin-bottom: 6rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.4);
}

.chapter-desc-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  line-height: 1.5;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  display: -webkit-box;
  -webkit-box-orient: vertical;
}

.chapter-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}

.status-dot-done {
  width: 40rpx;
  height: 40rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
}

.scroll-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 8rpx 0 16rpx;
}
