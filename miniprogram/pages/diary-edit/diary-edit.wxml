<!-- pages/diary-edit/diary-edit.wxml -->
<view class="page">

  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="nav-back-icon">←</text>
    </view>
    <text class="nav-title">{{pageTitle}}</text>
    <view class="nav-save-btn {{saving ? 'saving' : ''}}" bindtap="saveDiary">
      <text class="nav-save-text">{{saving ? '保存中' : '保存'}}</text>
    </view>
  </view>

  <!-- 示例提示横幅 -->
  <view wx:if="{{isSample}}" class="sample-banner">
    <text class="sample-banner-text">📖 这是示例随记，仅供参考</text>
  </view>

  <!-- 可滚动内容区 -->
  <scroll-view class="content" scroll-y>

    <!-- 标题输入 -->
    <input
      class="title-input"
      placeholder="随记标题"
      placeholder-class="title-ph"
      value="{{title}}"
      bindinput="onTitleInput"
      maxlength="50"
    />

    <!-- 图片区：无图时显示上传占位 -->
    <view wx:if="{{images.length === 0}}" class="photo-upload" bindtap="chooseImages">
      <text class="photo-upload-icon">📷</text>
      <text class="photo-upload-text">上传图片 记录美好瞬间</text>
    </view>

    <!-- 图片区：已有图时显示预览 -->
    <view wx:else class="photo-preview-wrap">
      <image class="photo-preview" src="{{images[0]}}" mode="aspectFill" />
      <view class="photo-change-btn" catchtap="chooseImages">
        <text class="photo-change-text">更换</text>
      </view>
    </view>

    <!-- 文字内容 -->
    <textarea
      class="content-textarea"
      placeholder="记录您现在想到的事情..."
      placeholder-class="textarea-ph"
      value="{{content}}"
      bindinput="onContentInput"
      auto-height
      show-confirm-bar="{{false}}"
      cursor-spacing="160"
    />

    <view class="content-spacer"></view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-btn-wrap" bindtap="toggleRecording">
      <view class="bottom-circle {{isRecording ? 'recording' : ''}}">
        <text class="bottom-circle-icon">🎤</text>
      </view>
      <text class="bottom-label">{{isRecording ? '结束录制' : '点击录制'}}</text>
    </view>
    <view class="bottom-btn-wrap" bindtap="aiPolish">
      <view class="bottom-circle {{aiPolishing ? 'loading' : ''}}">
        <text class="bottom-circle-icon">💬</text>
      </view>
      <text class="bottom-label">AI补全</text>
    </view>
  </view>

</view>
