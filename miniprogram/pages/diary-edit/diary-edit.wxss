/* pages/diary-edit/diary-edit.wxss */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f8f8;
}

.status-bar { background: #ffffff; flex-shrink: 0; }

/* 导航栏 */
.nav-bar {
  height: 88rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  background: #f5f5f5;
  border: 1rpx solid #e8e8e8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-icon { font-size: 32rpx; color: #333; line-height: 1; }

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  text-align: center;
}

.nav-save-btn {
  padding: 14rpx 32rpx;
  background: #f5f5f5;
  border: 1rpx solid #e8e8e8;
  border-radius: 40rpx;
}
.nav-save-btn.saving { opacity: 0.6; }
.nav-save-text { font-size: 28rpx; font-weight: bold; color: #333; }

/* 示例横幅 */
.sample-banner {
  background: #FFF8E1;
  border-bottom: 1rpx solid #FFE082;
  padding: 16rpx 28rpx;
  flex-shrink: 0;
}
.sample-banner-text { font-size: 24rpx; color: #8D6E00; }

/* 内容区 */
.content {
  flex: 1;
  overflow: hidden;
  padding: 28rpx 28rpx 0;
}

/* 标题输入 */
.title-input {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  display: block;
  width: 100%;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eeeeee;
  margin-bottom: 28rpx;
  background: transparent;
}
.title-ph { color: #ccc; font-size: 44rpx; font-weight: bold; }

/* 图片上传占位 */
.photo-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
  height: 280rpx;
  background: #ffffff;
  border: 3rpx dashed #e0e0e0;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.photo-upload-icon { width: 72rpx; height: 72rpx; margin-bottom: 16rpx; opacity: 0.5; }
.photo-upload-text { font-size: 28rpx; color: #999; font-weight: 500; }

/* 图片预览 */
.photo-preview-wrap {
  position: relative;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}
.photo-preview {
  width: 100%;
  height: 100%;
}
.photo-change-btn {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}
.photo-change-text { font-size: 24rpx; color: #fff; }

/* 文字内容 */
.content-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  background: transparent;
}
.textarea-ph { color: #bbb; font-size: 30rpx; }

.content-spacer { height: 32rpx; }

/* 底部操作栏 */
.bottom-bar {
  background: #f8f8f8;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 100rpx;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.bottom-btn-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.bottom-circle {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255,255,255,0.95);
  border: 2rpx solid #e0e0e0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.10);
}
.bottom-circle.recording {
  background: rgba(255,59,48,0.10);
  border-color: #FF3B30;
}
.bottom-circle.loading {
  background: rgba(0,122,255,0.10);
  border-color: #007AFF;
}

.bottom-circle-icon { width: 44rpx; height: 44rpx; }
.bottom-label { font-size: 24rpx; color: #333; font-weight: 500; }
