/* pages/diary-edit/diary-edit.wxss */

.container {
  background: #F5F0E8;
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* 工具栏 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #F0E8DF;
  position: sticky;
  top: 0;
  z-index: 100;
}

.toolbar-group {
  display: flex;
  gap: 10rpx;
}

.tool-btn {
  background: #F8F5F0;
  border-radius: 30rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: #666;
}

.tool-btn.active {
  background: #FFF0F0;
  color: #FF5252;
}

.tool-btn.ai-btn {
  background: #F0F4FF;
  color: #5C6BC0;
}

.tool-btn.loading {
  opacity: 0.5;
}

.save-btn {
  background: linear-gradient(135deg, #8B4513, #A0522D);
  color: #FFFFFF;
  border-radius: 30rpx;
  padding: 16rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.save-btn.loading {
  opacity: 0.6;
}

/* 心情选择 */
.mood-section {
  background: #FFFFFF;
  padding: 24rpx 30rpx;
  margin-top: 16rpx;
}

.section-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.mood-picker {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
}

.mood-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 90rpx;
  padding: 16rpx 14rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: #F8F5F0;
  transition: all 0.2s;
}

.mood-item.selected {
  border-color: #8B4513;
  background: #FFF3E8;
}

.mood-emoji {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.mood-label {
  font-size: 20rpx;
  color: #999;
}

/* 标题输入 */
.input-section {
  background: #FFFFFF;
  padding: 0 30rpx;
  margin-top: 2rpx;
}

.title-input {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0E8DF;
  width: 100%;
}

.input-placeholder {
  color: #DDCCBB;
  font-size: 38rpx;
  font-weight: normal;
}

/* 内容区 */
.content-section {
  background: #FFFFFF;
  padding: 24rpx 30rpx;
  margin-top: 2rpx;
}

.content-textarea {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  width: 100%;
  min-height: 400rpx;
}

.textarea-placeholder {
  color: #DDCCBB;
  font-size: 30rpx;
  line-height: 1.8;
}

.word-count {
  font-size: 22rpx;
  color: #BBAA99;
  text-align: right;
  display: block;
  margin-top: 12rpx;
}

/* 图片区 */
.images-section {
  background: #FFFFFF;
  padding: 24rpx 30rpx;
  margin-top: 16rpx;
}

.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
}

.thumb-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  object-fit: cover;
}

.remove-image {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF;
  font-size: 28rpx;
  font-weight: bold;
}

.add-image-btn {
  width: 200rpx;
  height: 200rpx;
  background: #F8F5F0;
  border: 2rpx dashed #D4A88C;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #D4A88C;
}

/* 标签区 */
.tags-section {
  background: #FFFFFF;
  padding: 24rpx 30rpx;
  margin-top: 16rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFF3E8;
  color: #8B4513;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.tag-remove {
  font-size: 26rpx;
  font-weight: bold;
  color: #C8855E;
}

.tag-input-wrap {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.tag-input {
  flex: 1;
  background: #F8F5F0;
  border-radius: 30rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #333;
}

.tag-add-btn {
  background: #8B4513;
  color: #FFF;
  border-radius: 30rpx;
  padding: 14rpx 30rpx;
  font-size: 26rpx;
}

/* 录音浮层 */
.recording-overlay {
  position: fixed;
  bottom: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.75);
  border-radius: 24rpx;
  padding: 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.rec-icon {
  font-size: 40rpx;
  animation: pulse 1s ease-in-out infinite;
}

.rec-time {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: bold;
}

.rec-tip {
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
